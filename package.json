{
  "name": "aplicacion-asist",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "demo": "npm run seed:demo && concurrently \"npm run backend:demo\" \"npm run frontend\"",
    "seed:demo": "npm run seed:demo --workspace=backend",
    "backend:demo": "npm run start:demo --workspace=backend",
    "frontend": "npm run dev --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}